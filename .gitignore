# Config per-environment — tidak di-track git, setiap server maintain salinannya sendiri.
# Template tersedia di config.php.example dan database.php.example
# Setup server: cp config.php.example config.php && cp database.php.example database.php
application/config/config.php
application/config/database.php

# Upload files — jangan commit ke git (data user)
uploads/

# Session & cache runtime
application/cache/sessions/
application/cache/import_tmp/
application/logs/

# macOS
.DS_Store

# SQL setup files (berisi password default)
siberkah_sumut_v4_setup.sql
landing_migration.sql

# Seed data — JANGAN commit, berisi data sensitif dari DB lokal
database/seed_data.sql

# IDE
.vscode/
.idea/

# PHP local config override
php.ini
.user.ini

# Docker files — hanya ada di branch railway-deploy
Dockerfile
docker-entrypoint.sh

# Panduan instalasi — berisi detail konfigurasi server internal
Installasi.md
installasiprov.md

# Claude Code session files
.claude/
