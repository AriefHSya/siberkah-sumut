// =============================================================================
// SIBERKAH SUMUT — database.php
// Salin file ini ke database.php lalu sesuaikan nilainya.
// File database.php TIDAK di-track git — setiap server maintain salinannya sendiri.
//
// Cara set env var di server Apache (VirtualHost):
//   SetEnv DB_HOST   localhost
//   SetEnv DB_USER   siberkah
//   SetEnv DB_PASS   password_anda
//   SetEnv DB_NAME   siberkah_sumut
//   SetEnv DB_PORT   3306
// =============================================================================

$active_group = 'default';
$query_builder = TRUE;
$db['default'] = [
    'dsn'          => '',
    'hostname'     => getenv('DB_HOST')     ?: 'localhost',
    'username'     => getenv('DB_USER')     ?: 'root',
    'password'     => getenv('DB_PASS')     ?: '',
    'database'     => getenv('DB_NAME')     ?: 'siberkah_sumut',
    'port'         => getenv('DB_PORT')     ?: 3306,
    'dbdriver'     => 'mysqli',
    'dbprefix'     => '',
    'pconnect'     => FALSE,
    'db_debug'     => (ENVIRONMENT !== 'production'),
    'cache_on'     => FALSE,
    'cachedir'     => '',
    'char_set'     => 'utf8mb4',
    'dbcollat'     => 'utf8mb4_unicode_ci',
    'swap_pre'     => '',
    'encrypt'      => FALSE,
    'compress'     => FALSE,
    'stricton'     => FALSE,
    'failover'     => [],
    'save_queries' => TRUE,
];
